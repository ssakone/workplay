# Configuration locale de signature/notarisation WorkPlay.
# Ce fichier est ignoré par git : il ne doit JAMAIS être publié.
#
# Copie-le en .env.local et renseigne TES valeurs.

# Dossier contenant le certificat Developer ID et la clé API
export WORKPLAY_CERTS="$HOME/chemin/vers/mes/certs"

# Certificat "Developer ID Application" (pour la signature de distribution)
export WORKPLAY_P12="$WORKPLAY_CERTS/mon-certificat-developer-id.p12"
export WORKPLAY_P12_PASS="$WORKPLAY_CERTS/mot-de-passe.txt"

# Clé API App Store Connect (pour la notarisation)
#   Key ID  : visible sur App Store Connect > Utilisateurs et accès > Intégrations
#   Issuer  : UUID du même écran (ou d'un fichier de config existant)
#   Fichier : AuthKey_<KEYID>.p8 téléchargé depuis ce même écran
export WORKPLAY_API_KEY="$WORKPLAY_CERTS/AuthKey_XXXXXXXXXX.p8"
export WORKPLAY_API_KEY_ID="XXXXXXXXXX"
export WORKPLAY_API_ISSUER="00000000-0000-0000-0000-000000000000"
